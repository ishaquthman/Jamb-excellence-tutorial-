    <!-- JAVASCRIPT LOGIC -->
    <script>
        // GLOBAL STATE
        const STORAGE_KEY_BANK = 'jamb_180_draft_bank_v3';
        const STORAGE_KEY_QUIZZES = 'jamb_180_quizzes_v3';
        const STORAGE_KEY_API_KEY = 'jamb_gemini_api_key';

        let draftQuestionBank = [];
        let publishedQuizzes = [];
        let parsedUploadQuestions = [];

        // CBT Simulator State
        let currentExam = null;
        let currentQuestionIndex = 0;
        let userAnswers = {};
        let flaggedQuestions = {};
        let timerInterval = null;
        let timeRemainingSeconds = 0;
        let examStartTime = 0;

        // PRE-LOADED 180 DEMO QUESTIONS (60 English + 40 Physics + 40 Math + 40 Chemistry = 180 Total)
        function generate180DemoQuestions() {
            const batch = [];
            const subjects = [
                { name: 'Use of English', count: 60 },
                { name: 'Physics', count: 40 },
                { name: 'Mathematics', count: 40 },
                { name: 'Chemistry', count: 40 }
            ];

            let globalIdx = 1;
            subjects.forEach(subObj => {
                for (let i = 1; i <= subObj.count; i++) {
                    batch.push({
                        id: `demo-180-${globalIdx}`,
                        subject: subObj.name,
                        topic: `${subObj.name} Module ${Math.ceil(i / 10)}`,
                        question: `[Q${globalIdx} - ${subObj.name}] Sample UTME past question on item #${i}. Evaluate the primary core principle in relation to standard parameters.`,
                        options: {
                            A: `Option A for item ${globalIdx} context`,
                            B: `Option B for item ${globalIdx} context (Correct)`,
                            C: `Option C for item ${globalIdx} context`,
                            D: `Option D for item ${globalIdx} context`
                        },
                        correct: 'B',
                        explanation: `Official UTME standard solution for Q${globalIdx}: Option B correctly satisfies the criteria for ${subObj.name}.`
                    });
                    globalIdx++;
                }
            });
            return batch;
        }

        // INITIALIZATION
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedData();
            if (draftQuestionBank.length === 0) {
                draftQuestionBank = generate180DemoQuestions();
                saveToStorage();
            }
            if (publishedQuizzes.length === 0) {
                publishedQuizzes.push({
                    id: 'pub-mock-180',
                    code: 'JAMB-MOCK-180',
                    title: 'UTME 2026 Grand 180-Question Full Combo Mock',
                    subject: 'Full 4-Subject Combo',
                    duration: 120,
                    questionLimit: 180,
                    questions: [...draftQuestionBank]
                });
                saveToStorage();
            }
            renderQuestionBank();
            renderPublishedQuizzes();
            renderAvailableLobbyQuizzes();
            updateStats();
        });

        function loadSavedData() {
            try {
                const bank = localStorage.getItem(STORAGE_KEY_BANK);
                if (bank) draftQuestionBank = JSON.parse(bank);

                const quiz = localStorage.getItem(STORAGE_KEY_QUIZZES);
                if (quiz) publishedQuizzes = JSON.parse(quiz);

                const key = localStorage.getItem(STORAGE_KEY_API_KEY);
                if (key) document.getElementById('ai-api-key').value = key;
            } catch (e) {
                console.error("Error loading storage", e);
            }
        }

        function saveToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY_BANK, JSON.stringify(draftQuestionBank));
                localStorage.setItem(STORAGE_KEY_QUIZZES, JSON.stringify(publishedQuizzes));
                updateStats();
            } catch (e) {
                console.error("Error saving storage", e);
            }
        }

        function saveApiKeyLocally() {
            const key = document.getElementById('ai-api-key').value.trim();
            localStorage.setItem(STORAGE_KEY_API_KEY, key);
            showToast("Gemini API key saved locally!", "success");
        }

        function updateStats() {
            const total = draftQuestionBank.length;
            document.getElementById('stat-total-questions').innerText = `${total} Qs`;
            document.getElementById('hdr-stat-bank').innerText = `${total} / 180 Qs`;
            document.getElementById('stat-published-quizzes').innerText = `${publishedQuizzes.length} Exams`;
            document.getElementById('hdr-stat-quizzes').innerText = `${publishedQuizzes.length} Active`;
            document.getElementById('pub-quiz-count').innerText = publishedQuizzes.length;
            updateActiveSubjectDisplay();
        }

        function updateActiveSubjectDisplay() {
            const activeSub = document.getElementById('ai-subject').value;
            document.getElementById('stat-active-subject').innerText = activeSub;

            const subCount = draftQuestionBank.filter(q => q.subject === activeSub).length;
            document.getElementById('stat-batch-count').innerText = `${subCount} / 180 Qs`;
            const pct = Math.min(100, Math.round((subCount / 180) * 100));
            document.getElementById('stat-batch-percent').innerText = `${pct}%`;
            document.getElementById('stat-batch-bar').style.width = `${pct}%`;
        }

        // ROLE & TAB SWITCHERS
        function switchRole(role) {
            const admin = document.getElementById('admin-portal');
            const student = document.getElementById('student-portal');
            const adminBtn = document.getElementById('nav-admin-btn');
            const studentBtn = document.getElementById('nav-student-btn');

            if (role === 'admin') {
                admin.classList.remove('hidden');
                student.classList.add('hidden');
                adminBtn.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-white bg-jamb-green shadow";
                studentBtn.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-emerald-200 hover:text-white";
                renderQuestionBank();
            } else {
                admin.classList.add('hidden');
                student.classList.remove('hidden');
                studentBtn.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-white bg-jamb-green shadow";
                adminBtn.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-emerald-200 hover:text-white";
                renderAvailableLobbyQuizzes();
            }
        }

        function switchAdminTab(tabName) {
            document.querySelectorAll('.admin-tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.admin-tab-btn').forEach(btn => {
                btn.classList.remove('border-jamb-green', 'text-jamb-green', 'bg-white');
                btn.classList.add('border-transparent', 'text-slate-600');
            });

            const activeTab = document.getElementById(`admin-tab-${tabName}`);
            const activeBtn = document.getElementById(`tab-btn-${tabName}`);
            if (activeTab && activeBtn) {
                activeTab.classList.remove('hidden');
                activeBtn.classList.add('border-jamb-green', 'text-jamb-green', 'bg-white');
                activeBtn.classList.remove('border-transparent', 'text-slate-600');
            }
        }

        // GEMINI AI BATCH GENERATOR (UP TO 180 Qs)
        async function generateAIBatch(e) {
            e.preventDefault();
            const subject = document.getElementById('ai-subject').value;
            const targetTotal = parseInt(document.getElementById('ai-count').value, 10) || 10;
            const difficulty = document.getElementById('ai-difficulty').value;
            const promptFocus = document.getElementById('ai-prompt').value;
            const apiKey = document.getElementById('ai-api-key').value.trim();

            if (!apiKey) {
                showToast("Please enter your Gemini API key!", "error");
                return;
            }

            const progressContainer = document.getElementById('ai-progress-container');
            const progressBar = document.getElementById('ai-progress-bar');
            const progressStatus = document.getElementById('ai-progress-status');
            const progressText = document.getElementById('ai-progress-text');
            const submitBtn = document.getElementById('ai-submit-btn');

            progressContainer.classList.remove('hidden');
            submitBtn.disabled = true;

            const chunkSize = 15; // API call chunking size
            let totalGenerated = 0;
            const iterations = Math.ceil(targetTotal / chunkSize);

            for (let i = 0; i < iterations; i++) {
                const countThisBatch = Math.min(chunkSize, targetTotal - totalGenerated);
                const currentPct = Math.round((totalGenerated / targetTotal) * 100);
                
                progressBar.style.width = `${currentPct}%`;
                progressText.innerText = `${currentPct}%`;
                progressStatus.innerText = `Generating Chunk ${i+1}/${iterations} (${totalGenerated}/${targetTotal} Qs)...`;

                const payload = {
                    contents: [{
                        parts: [{
                            text: `Generate ${countThisBatch} standard Nigerian JAMB UTME multiple choice questions for subject "${subject}". Topic/Focus: ${promptFocus}. Difficulty: ${difficulty}. Return strictly JSON array matching standard schema.`
                        }]
                    }],
                    systemInstruction: {
                        parts: [{ text: "You are an expert Nigerian JAMB UTME test author. Return authentic 4-option questions with detailed solutions." }]
                    },
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: {
                            type: "ARRAY",
                            items: {
                                type: "OBJECT",
                                properties: {
                                    "question": { "type": "STRING" },
                                    "topic": { "type": "STRING" },
                                    "optionA": { "type": "STRING" },
                                    "optionB": { "type": "STRING" },
                                    "optionC": { "type": "STRING" },
                                    "optionD": { "type": "STRING" },
                                    "correct": { "type": "STRING", "description": "A, B, C, or D" },
                                    "explanation": { "type": "STRING" }
                                },
                                "propertyOrdering": ["question", "topic", "optionA", "optionB", "optionC", "optionD", "correct", "explanation"]
                            }
                        }
                    }
                };

                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;

                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) throw new Error(`API Error ${response.status}`);
                    const result = await response.json();
                    const jsonText = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    const items = JSON.parse(jsonText);

                    items.forEach(item => {
                        draftQuestionBank.unshift({
                            id: 'ai-180-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),
                            subject,
                            topic: item.topic || promptFocus,
                            question: item.question,
                            options: { A: item.optionA, B: item.optionB, C: item.optionC, D: item.optionD },
                            correct: item.correct.toUpperCase().trim(),
                            explanation: item.explanation || "Standard UTME concept."
                        });
                        totalGenerated++;
                    });

                    saveToStorage();
                    renderQuestionBank();

                } catch (err) {
                    console.error("Chunk batch error", err);
                    showToast(`Error in batch generation: ${err.message}`, 'error');
                    break;
                }
            }

            progressBar.style.width = `100%`;
            progressText.innerText = `100%`;
            progressStatus.innerText = `Batch Generation Complete! (${totalGenerated} Questions added)`;
            submitBtn.disabled = false;
            showToast(`Successfully generated ${totalGenerated} AI questions!`, 'success');
        }

        // CSV / JSON FILE UPLOAD
        function handleFileUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            if (file.name.endsWith('.json')) {
                reader.onload = (event) => {
                    try {
                        const parsed = JSON.parse(event.target.result);
                        parsedUploadQuestions = formatParsedBatch(parsed);
                        renderParsedPreview();
                    } catch (err) { showToast("Invalid JSON file format", "error"); }
                };
                reader.readAsText(file);
            } else if (file.name.endsWith('.csv')) {
                reader.onload = (event) => {
                    try {
                        const items = parseCSV(event.target.result);
                        parsedUploadQuestions = formatParsedBatch(items);
                        renderParsedPreview();
                    } catch (err) { showToast("Invalid CSV structure", "error"); }
                };
                reader.readAsText(file);
            }
        }

        function parseCSV(text) {
            const lines = text.split(/\r\n|\n/);
            const results = [];
            for (let i = 1; i < lines.length; i++) {
                if (!lines[i].trim()) continue;
                const matches = lines[i].match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g) || lines[i].split(',');
                const row = matches.map(m => m.trim().replace(/^"|"$/g, ''));
                if (row.length >= 7) {
                    results.push({
                        subject: row[0] || 'Use of English',
                        question: row[1] || '',
                        optionA: row[2] || '',
                        optionB: row[3] || '',
                        optionC: row[4] || '',
                        optionD: row[5] || '',
                        correct: row[6] || 'A',
                        explanation: row[7] || 'Standard Question'
                    });
                }
            }
            return results;
        }

        function formatParsedBatch(items) {
            return items.map((item, idx) => ({
                id: 'file-180-' + Date.now() + '-' + idx,
                subject: item.subject || 'Use of English',
                topic: item.topic || 'General',
                question: item.question || item.text || 'Untitled Question',
                options: {
                    A: item.optionA || (item.options ? item.options.A : 'Option A'),
                    B: item.optionB || (item.options ? item.options.B : 'Option B'),
                    C: item.optionC || (item.options ? item.options.C : 'Option C'),
                    D: item.optionD || (item.options ? item.options.D : 'Option D')
                },
                correct: (item.correct || 'A').toUpperCase().trim(),
                explanation: item.explanation || 'Solution available.'
            }));
        }

        function renderParsedPreview() {
            const container = document.getElementById('file-preview-container');
            const tbody = document.getElementById('parsed-table-body');
            document.getElementById('parsed-count').innerText = parsedUploadQuestions.length;

            tbody.innerHTML = '';
            parsedUploadQuestions.forEach((q, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2 border-b font-mono text-slate-400">${idx + 1}</td>
                    <td class="p-2 border-b font-bold text-slate-700">${escapeHtml(q.subject)}</td>
                    <td class="p-2 border-b max-w-xs truncate">${escapeHtml(q.question)}</td>
                    <td class="p-2 border-b font-bold text-jamb-green">${q.correct}</td>
                `;
                tbody.appendChild(tr);
            });
            container.classList.remove('hidden');
        }

        function importParsedQuestions() {
            draftQuestionBank = [...parsedUploadQuestions, ...draftQuestionBank];
            saveToStorage();
            renderQuestionBank();
            showToast(`Imported ${parsedUploadQuestions.length} questions!`, 'success');
            parsedUploadQuestions = [];
            document.getElementById('file-preview-container').classList.add('hidden');
        }

        function downloadSampleCSV() {
            const csv = `Subject,Question,OptionA,OptionB,OptionC,OptionD,Correct,Explanation
"Physics","Calculate force when mass is 10kg and acceleration is 2m/s2","20N","5N","12N","8N","A","F = m * a = 10 * 2 = 20N"`;
            downloadFile(csv, 'jamb_batch_sample_180.csv', 'text/csv');
        }

        function downloadSampleJSON() {
            const json = [{ subject: "Mathematics", question: "Evaluate 2^3", options: { A: "8", B: "6", C: "4", D: "2" }, correct: "A", explanation: "2*2*2=8" }];
            downloadFile(JSON.stringify(json, null, 2), 'jamb_batch_sample_180.json', 'application/json');
        }

        // MANUAL QUESTION FORM
        function handleManualSubmit(e) {
            e.preventDefault();
            const newQ = {
                id: 'q-' + Date.now(),
                subject: document.getElementById('manual-subject').value,
                topic: document.getElementById('manual-topic').value || 'General',
                question: document.getElementById('manual-text').value,
                options: {
                    A: document.getElementById('manual-opt-a').value,
                    B: document.getElementById('manual-opt-b').value,
                    C: document.getElementById('manual-opt-c').value,
                    D: document.getElementById('manual-opt-d').value
                },
                correct: document.getElementById('manual-correct').value,
                explanation: document.getElementById('manual-explanation').value
            };

            draftQuestionBank.unshift(newQ);
            saveToStorage();
            renderQuestionBank();
            document.getElementById('manual-question-form').reset();
            showToast('Question saved to draft bank!', 'success');
        }

        // DRAFT BANK MANAGER
        function renderQuestionBank() {
            const list = document.getElementById('draft-bank-list');
            const search = document.getElementById('bank-search').value.toLowerCase();
            const subFilter = document.getElementById('bank-filter-subject').value;

            list.innerHTML = '';
            const filtered = draftQuestionBank.filter(q => {
                const matchSearch = q.question.toLowerCase().includes(search) || (q.topic && q.topic.toLowerCase().includes(search));
                const matchSub = subFilter === 'ALL' || q.subject === subFilter;
                return matchSearch && matchSub;
            });

            if (filtered.length === 0) {
                list.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs">No questions found matching criteria.</div>`;
                return;
            }

            filtered.forEach((q, idx) => {
                const item = document.createElement('div');
                item.className = "p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-start justify-between gap-3 text-xs";
                item.innerHTML = `
                    <div class="space-y-1 flex-grow">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-[9px] uppercase bg-jamb-green text-white px-2 py-0.5 rounded">${escapeHtml(q.subject)}</span>
                            <span class="text-slate-400 font-medium text-[11px]">${escapeHtml(q.topic || 'General')}</span>
                        </div>
                        <div class="font-bold text-slate-800 text-xs">${escapeHtml(q.question)}</div>
                        <div class="text-[11px] text-jamb-green font-bold">Key Answer: Option ${q.correct}</div>
                    </div>
                    <button onclick="deleteBankQuestion('${q.id}')" class="text-red-400 hover:text-red-600 p-1">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                `;
                list.appendChild(item);
            });
        }

        function deleteBankQuestion(id) {
            draftQuestionBank = draftQuestionBank.filter(q => q.id !== id);
            saveToStorage();
            renderQuestionBank();
        }

        function clearDraftBank() {
            if (confirm("Clear all draft questions?")) {
                draftQuestionBank = [];
                saveToStorage();
                renderQuestionBank();
            }
        }

        function loadDemo180Questions() {
            draftQuestionBank = generate180DemoQuestions();
            saveToStorage();
            renderQuestionBank();
            showToast("180-Question Full UTME Combo Demo Loaded!", "success");
        }

        // PUBLISH MOCK EXAM
        function publishQuiz(e) {
            e.preventDefault();
            if (draftQuestionBank.length === 0) {
                showToast("Cannot publish: Question bank is empty!", "error");
                return;
            }

            const title = document.getElementById('pub-title').value;
            const code = document.getElementById('pub-code').value.toUpperCase().trim();
            const subject = document.getElementById('pub-subject').value;
            const qLimit = Math.min(180, parseInt(document.getElementById('pub-q-count').value, 10));
            const duration = parseInt(document.getElementById('pub-duration').value, 10);

            let questionsForQuiz = draftQuestionBank;
            if (subject !== 'Full 4-Subject Combo') {
                const subFiltered = draftQuestionBank.filter(q => q.subject === subject);
                if (subFiltered.length > 0) questionsForQuiz = subFiltered;
            }
            questionsForQuiz = questionsForQuiz.slice(0, qLimit);

            const newQuiz = {
                id: 'quiz-180-' + Date.now(),
                code,
                title,
                subject,
                duration,
                questionLimit: questionsForQuiz.length,
                questions: questionsForQuiz
            };

            const idx = publishedQuizzes.findIndex(q => q.code === code);
            if (idx >= 0) publishedQuizzes[idx] = newQuiz;
            else publishedQuizzes.push(newQuiz);

            saveToStorage();
            renderPublishedQuizzes();
            renderAvailableLobbyQuizzes();
            showToast(`Published Mock Exam Code: ${code} (${questionsForQuiz.length} Qs)`, 'success');
        }

        function renderPublishedQuizzes() {
            const list = document.getElementById('published-quiz-list');
            list.innerHTML = '';
            publishedQuizzes.forEach(quiz => {
                const card = document.createElement('div');
                card.className = "p-2 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-between";
                card.innerHTML = `
                    <div>
                        <span class="bg-jamb-gold text-black font-mono font-bold text-[10px] px-1.5 py-0.5 rounded">${quiz.code}</span>
                        <span class="font-bold text-slate-800 ml-1.5">${escapeHtml(quiz.title)}</span>
                        <div class="text-[10px] text-slate-500">${quiz.questions.length} Qs • ${quiz.duration} mins</div>
                    </div>
                    <button onclick="deletePublishedQuiz('${quiz.id}')" class="text-red-400 hover:text-red-600 p-1"><i class="fa-solid fa-xmark"></i></button>
                `;
                list.appendChild(card);
            });
        }

        function deletePublishedQuiz(id) {
            publishedQuizzes = publishedQuizzes.filter(q => q.id !== id);
            saveToStorage();
            renderPublishedQuizzes();
            renderAvailableLobbyQuizzes();
        }

        function exportAllQuizzes() {
            downloadFile(JSON.stringify(publishedQuizzes, null, 2), 'jamb_180_published_quizzes.json', 'application/json');
        }

        // CBT SIMULATOR & 180-GRID PALETTE
        function renderAvailableLobbyQuizzes() {
            const container = document.getElementById('available-quiz-cards');
            container.innerHTML = '';
            publishedQuizzes.forEach(quiz => {
                const card = document.createElement('div');
                card.className = "p-4 bg-white hover:bg-emerald-50/50 border border-slate-200 hover:border-jamb-green rounded-xl transition flex items-center justify-between cursor-pointer shadow-sm";
                card.onclick = () => launchExam(quiz);
                card.innerHTML = `
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="bg-jamb-green text-white font-mono font-bold text-xs px-2 py-0.5 rounded">${quiz.code}</span>
                            <h4 class="font-bold text-slate-800 text-xs">${escapeHtml(quiz.title)}</h4>
                        </div>
                        <div class="text-[11px] text-slate-500 flex items-center gap-3">
                            <span><i class="fa-solid fa-clock text-slate-400"></i> ${quiz.duration} Mins</span>
                            <span><i class="fa-solid fa-list-check text-jamb-green"></i> ${quiz.questions.length} Questions</span>
                        </div>
                    </div>
                    <button class="bg-jamb-green hover:bg-jamb-darkgreen text-white font-bold text-xs px-4 py-2 rounded-xl transition">Start</button>
                `;
                container.appendChild(card);
            });
        }

        function startExamByCode() {
            const code = document.getElementById('access-code-input').value.toUpperCase().trim();
            const found = publishedQuizzes.find(q => q.code === code);
            if (found) launchExam(found);
            else showToast(`Exam code "${code}" not found!`, "error");
        }

        function launchExam(quiz) {
            currentExam = quiz;
            currentQuestionIndex = 0;
            userAnswers = {};
            flaggedQuestions = {};
            timeRemainingSeconds = quiz.duration * 60;
            examStartTime = Date.now();

            document.getElementById('cbt-lobby').classList.add('hidden');
            document.getElementById('cbt-result-screen').classList.add('hidden');
            document.getElementById('cbt-exam-room').classList.remove('hidden');

            document.getElementById('cbt-active-title').innerText = quiz.title;
            document.getElementById('cbt-active-subject').innerText = quiz.subject;
            document.getElementById('cbt-total-count').innerText = quiz.questions.length;
            document.getElementById('palette-total-count').innerText = quiz.questions.length;

            startTimer();
            renderCBTQuestion();
            renderPalette();
        }

        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            const timerCard = document.getElementById('timer-card');
            timerCard.classList.remove('timer-warning');

            updateTimerDisplay();
            timerInterval = setInterval(() => {
                timeRemainingSeconds--;
                updateTimerDisplay();

                // Alert when less than 5 mins remain
                if (timeRemainingSeconds <= 300 && !timerCard.classList.contains('timer-warning')) {
                    timerCard.classList.add('timer-warning');
                    showToast("Warning: Less than 5 minutes remaining!", "error");
                }

                if (timeRemainingSeconds <= 0) {
                    clearInterval(timerInterval);
                    showToast("Time expired! Automatically submitting exam...", "info");
                    finishExam();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const hrs = Math.floor(timeRemainingSeconds / 3600);
            const mins = Math.floor((timeRemainingSeconds % 3600) / 60);
            const secs = timeRemainingSeconds % 60;
            const fmt = (n) => String(n).padStart(2, '0');
            document.getElementById('cbt-timer-display').innerText = `${fmt(hrs)}:${fmt(mins)}:${fmt(secs)}`;
        }

        function renderCBTQuestion() {
            const q = currentExam.questions[currentQuestionIndex];
            document.getElementById('cbt-q-number').innerText = currentQuestionIndex + 1;
            document.getElementById('cbt-q-subject-badge').innerText = q.subject;
            document.getElementById('cbt-question-text').innerText = q.question;

            const flaggedTag = document.getElementById('cbt-flagged-tag');
            const flagBtn = document.getElementById('flag-btn');
            if (flaggedQuestions[currentQuestionIndex]) {
                flaggedTag.classList.remove('hidden');
                flagBtn.className = "bg-amber-500 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition flex items-center gap-1.5";
            } else {
                flaggedTag.classList.add('hidden');
                flagBtn.className = "bg-amber-100 text-amber-800 hover:bg-amber-200 text-xs font-bold py-2.5 px-4 rounded-xl transition flex items-center gap-1.5";
            }

            const container = document.getElementById('cbt-options-container');
            container.innerHTML = '';
            const selected = userAnswers[currentQuestionIndex];

            ['A', 'B', 'C', 'D'].forEach(letter => {
                const div = document.createElement('div');
                div.innerHTML = `
                    <input type="radio" id="opt-${letter}" name="cbt-opt" value="${letter}" ${selected === letter ? 'checked' : ''} onchange="selectAnswer('${letter}')" class="hidden cbt-option-radio">
                    <label for="opt-${letter}" class="flex items-start gap-3 p-3.5 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-emerald-300 transition text-xs text-slate-700">
                        <span class="w-6 h-6 rounded-full bg-slate-100 font-bold text-xs flex items-center justify-center text-slate-600 flex-shrink-0">${letter}</span>
                        <span class="leading-relaxed">${escapeHtml(q.options[letter])}</span>
                    </label>
                `;
                container.appendChild(div);
            });

            document.getElementById('cbt-prev-btn').disabled = currentQuestionIndex === 0;
            document.getElementById('cbt-prev-btn').classList.toggle('opacity-50', currentQuestionIndex === 0);
            renderPalette();
        }

        function selectAnswer(letter) {
            userAnswers[currentQuestionIndex] = letter;
            renderPalette();
        }

        function toggleFlagQuestion() {
            if (flaggedQuestions[currentQuestionIndex]) {
                delete flaggedQuestions[currentQuestionIndex];
            } else {
                flaggedQuestions[currentQuestionIndex] = true;
            }
            renderCBTQuestion();
        }

        function navQuestion(dir) {
            const nextIdx = currentQuestionIndex + dir;
            if (nextIdx >= 0 && nextIdx < currentExam.questions.length) {
                currentQuestionIndex = nextIdx;
                renderCBTQuestion();
            } else if (nextIdx >= currentExam.questions.length) {
                confirmSubmitExam();
            }
        }

        function renderPalette() {
            const grid = document.getElementById('cbt-palette-grid');
            grid.innerHTML = '';
            let answered = 0;

            currentExam.questions.forEach((_, idx) => {
                const isAns = userAnswers.hasOwnProperty(idx);
                const isFlagged = flaggedQuestions[idx];
                if (isAns) answered++;

                const btn = document.createElement('button');
                btn.onclick = () => { currentQuestionIndex = idx; renderCBTQuestion(); };

                let cls = "bg-slate-100 text-slate-700 border-slate-200";
                if (idx === currentQuestionIndex) cls = "bg-blue-600 text-white font-bold ring-2 ring-blue-300";
                else if (isFlagged) cls = "bg-amber-500 text-white font-bold";
                else if (isAns) cls = "bg-jamb-green text-white font-bold";

                btn.className = `w-6 h-6 rounded palette-btn border flex items-center justify-center ${cls}`;
                btn.innerText = idx + 1;
                grid.appendChild(btn);
            });

            document.getElementById('palette-answered-count').innerText = answered;
        }

        function confirmSubmitExam() {
            if (confirm("Submit your JAMB CBT exam now?")) finishExam();
        }

        function finishExam() {
            if (timerInterval) clearInterval(timerInterval);

            const timeSpent = Math.max(1, Math.floor((Date.now() - examStartTime) / 1000));
            const total = currentExam.questions.length;
            let correct = 0;

            currentExam.questions.forEach((q, idx) => {
                if (userAnswers[idx] === q.correct) correct++;
            });

            const pct = Math.round((correct / total) * 100);
            const jambScaled = Math.round((correct / total) * 400);

            document.getElementById('cbt-exam-room').classList.add('hidden');
            document.getElementById('cbt-result-screen').classList.remove('hidden');

            document.getElementById('result-jamb-scaled').innerText = `${jambScaled} / 400`;
            document.getElementById('result-percent-text').innerText = `${pct}%`;
            document.getElementById('result-time-text').innerText = `${Math.floor(timeSpent/60)}m ${timeSpent%60}s`;

            const breakdown = document.getElementById('result-breakdown-list');
            breakdown.innerHTML = '';

            currentExam.questions.forEach((q, idx) => {
                const userAns = userAnswers[idx] || 'None';
                const isRight = userAns === q.correct;
                const card = document.createElement('div');
                card.className = "pt-4 first:pt-0 space-y-2 text-xs";
                card.innerHTML = `
                    <div class="flex items-start justify-between gap-3">
                        <div class="font-bold text-slate-800">Q${idx + 1} [${escapeHtml(q.subject)}]. ${escapeHtml(q.question)}</div>
                        <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] ${isRight ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                            ${isRight ? 'Correct' : 'Incorrect'}
                        </span>
                    </div>
                    <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-200 text-emerald-900">
                        <div class="font-bold mb-1">Your Pick: ${userAns} | Correct Answer: Option ${q.correct}</div>
                        <p class="text-slate-700">${escapeHtml(q.explanation)}</p>
                    </div>
                `;
                breakdown.appendChild(card);
            });
        }

        function returnToLobby() {
            document.getElementById('cbt-result-screen').classList.add('hidden');
            document.getElementById('cbt-lobby').classList.remove('hidden');
            renderAvailableLobbyQuizzes();
        }

        // UTILS
        function showToast(msg, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            let bg = type === 'success' ? 'bg-jamb-green text-white' : (type === 'error' ? 'bg-red-600 text-white' : 'bg-slate-800 text-white');
            toast.className = `p-3.5 rounded-xl shadow-lg ${bg} text-xs font-semibold flex items-center justify-between pointer-events-auto transition duration-300`;
            toast.innerHTML = `<span>${escapeHtml(msg)}</span><button onclick="this.parentElement.remove()" class="ml-3"><i class="fa-solid fa-xmark"></i></button>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        function downloadFile(content, fileName, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }
    </script>
</body>
</html>
