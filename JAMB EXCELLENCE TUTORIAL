```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JAMB Excellence Tutorial - Ultimate CBT Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        jamb: {
                            green: '#008751',
                            darkgreen: '#005c37',
                            lightgreen: '#e6f4ed',
                            gold: '#FFD700',
                            goldhover: '#d4af37',
                            darkbg: '#0f172a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #008751; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #005c37; }
        .cbt-option-radio:checked + label {
            border-color: #008751;
            background-color: #e6f4ed;
            font-weight: 600;
        }
        .palette-btn {
            font-size: 10px;
            font-weight: 700;
            transition: all 0.15s ease;
        }
        @keyframes timer-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.02); }
        }
        .timer-warning {
            animation: timer-pulse 1s infinite;
            background-color: #dc2626 !important;
            color: #ffffff !important;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex flex-col min-h-screen font-sans">

    <!-- HEADER / BRANDING BANNER -->
    <header class="bg-jamb-green text-white shadow-lg sticky top-0 z-50 border-b-2 border-jamb-gold">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-11 h-11 bg-white rounded-full flex items-center justify-center text-jamb-green shadow-md border-2 border-jamb-gold">
                    <i class="fa-solid fa-graduation-cap text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black tracking-tight flex items-center gap-2">
                        JAMB Excellence Tutorial
                        <span class="bg-jamb-gold text-black font-extrabold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider">180-Q UTME CBT</span>
                    </h1>
                    <p class="text-xs text-emerald-100 font-medium">Ultimate CBT Portal & AI Generator (Full 4-Subject Combinations)</p>
                </div>
            </div>

            <!-- ROLE SWITCHER & STATS BADGES -->
            <div class="flex items-center space-x-3 self-end md:self-auto">
                <div class="hidden sm:flex items-center gap-3 mr-2 text-xs">
                    <div class="bg-jamb-darkgreen px-3 py-1.5 rounded-lg border border-emerald-600/40">
                        <span class="text-emerald-200">Bank Pool:</span>
                        <strong id="hdr-stat-bank" class="text-white ml-1">0 / 180 Qs</strong>
                    </div>
                    <div class="bg-jamb-darkgreen px-3 py-1.5 rounded-lg border border-emerald-600/40">
                        <span class="text-emerald-200">Exams:</span>
                        <strong id="hdr-stat-quizzes" class="text-jamb-gold ml-1">0 Active</strong>
                    </div>
                </div>

                <div class="bg-jamb-darkgreen p-1 rounded-xl flex items-center border border-emerald-600/40 shadow-inner">
                    <button id="nav-admin-btn" onclick="switchRole('admin')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-white bg-jamb-green shadow">
                        <i class="fa-solid fa-user-gear"></i> Instructor
                    </button>
                    <button id="nav-student-btn" onclick="switchRole('student')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-emerald-200 hover:text-white">
                        <i class="fa-solid fa-laptop-code"></i> CBT Student
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- NOTIFICATION TOAST CONTAINER -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full px-4 pointer-events-none"></div>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ========================================== -->
        <!-- VIEW 1: INSTRUCTOR PORTAL (ADMIN & CREATOR) -->
        <!-- ========================================== -->
        <section id="admin-portal" class="space-y-6">
            
            <!-- Dashboard Stats & Target Batch Bar (Max 180 Qs) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Active Subject Focus</div>
                    <div id="stat-active-subject" class="text-lg font-black text-slate-800 mt-1">Full 4-Subject Combo</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="text-xs text-slate-500 font-semibold uppercase">180-Q Batch Progress</div>
                    <div class="flex items-center justify-between mt-1">
                        <div id="stat-batch-count" class="text-lg font-black text-jamb-green">0 / 180 Qs</div>
                        <span id="stat-batch-percent" class="text-xs font-bold bg-emerald-100 text-jamb-green px-2 py-0.5 rounded">0%</span>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full mt-2 overflow-hidden">
                        <div id="stat-batch-bar" class="bg-jamb-green h-full w-0 transition-all duration-300"></div>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Master Bank Pool</div>
                    <div id="stat-total-questions" class="text-lg font-black text-slate-800 mt-1">0 Questions</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Published Mock Exams</div>
                    <div id="stat-published-quizzes" class="text-lg font-black text-amber-600 mt-1">0 Exams</div>
                </div>
            </div>

            <!-- Question Creation Tools Navigation -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="border-b border-slate-200 bg-slate-50/80 px-4 pt-3 flex flex-wrap gap-2">
                    <button onclick="switchAdminTab('ai')" id="tab-btn-ai" class="admin-tab-btn py-2.5 px-4 rounded-t-xl text-xs font-bold border-b-2 border-jamb-green text-jamb-green bg-white flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-amber-500"></i> AI Batch Generator (Up to 180)
                    </button>
                    <button onclick="switchAdminTab('upload')" id="tab-btn-upload" class="admin-tab-btn py-2.5 px-4 rounded-t-xl text-xs font-semibold border-b-2 border-transparent text-slate-600 hover:text-jamb-green flex items-center gap-2">
                        <i class="fa-solid fa-file-import text-blue-600"></i> CSV / JSON Bulk Upload (Up to 180)
                    </button>
                    <button onclick="switchAdminTab('manual')" id="tab-btn-manual" class="admin-tab-btn py-2.5 px-4 rounded-t-xl text-xs font-semibold border-b-2 border-transparent text-slate-600 hover:text-jamb-green flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square"></i> Single Manual Creator
                    </button>
                </div>

                <div class="p-6">

                    <!-- METHOD A: GEMINI AI BATCH GENERATOR -->
                    <div id="admin-tab-ai" class="admin-tab-content space-y-4">
                        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3">
                            <i class="fa-solid fa-microchip text-2xl text-amber-600 mt-1"></i>
                            <div>
                                <h4 class="font-extrabold text-amber-900 text-sm">Gemini AI Batch Generator Engine (`gemini-2.5-flash`)</h4>
                                <p class="text-xs text-amber-800">Generates authentic JAMB UTME multiple choice items with options A-D and detailed solutions. Auto-chunks large requests up to 180 questions into background API batches.</p>
                            </div>
                        </div>

                        <form id="ai-generator-form" onsubmit="generateAIBatch(event)" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Subject</label>
                                    <select id="ai-subject" onchange="updateActiveSubjectDisplay()" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs font-bold bg-white" required>
                                        <option value="Use of English">Use of English (60 Qs Standard)</option>
                                        <option value="Mathematics">Mathematics (40 Qs Standard)</option>
                                        <option value="Physics">Physics (40 Qs Standard)</option>
                                        <option value="Chemistry">Chemistry (40 Qs Standard)</option>
                                        <option value="Biology">Biology (40 Qs Standard)</option>
                                        <option value="Economics">Economics (40 Qs Standard)</option>
                                        <option value="Government">Government (40 Qs Standard)</option>
                                        <option value="Commerce">Commerce (40 Qs Standard)</option>
                                        <option value="Literature in English">Literature in English</option>
                                        <option value="CRS/IRS">CRK / IRK</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Batch Count (Max 180)</label>
                                    <select id="ai-count" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs font-bold bg-white">
                                        <option value="10">10 Questions (Quick Draft)</option>
                                        <option value="20">20 Questions (Half Subject)</option>
                                        <option value="40">40 Questions (1 Standard Subject)</option>
                                        <option value="60">60 Questions (Use of English Batch)</option>
                                        <option value="100">100 Questions (2-Subject Combination)</option>
                                        <option value="120">120 Questions (3-Subject Combination)</option>
                                        <option value="160">160 Questions (Near Full UTME)</option>
                                        <option value="180" selected>180 Questions (FULL 4-Subject UTME Mock)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Difficulty Level</label>
                                    <select id="ai-difficulty" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs bg-white">
                                        <option value="Standard UTME Level">Standard UTME Level</option>
                                        <option value="Advanced JAMB / Hard">Advanced JAMB / Hard</option>
                                        <option value="Fundamental Concepts">Fundamental Concepts</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Gemini API Key</label>
                                    <input type="password" id="ai-api-key" onchange="saveApiKeyLocally()" placeholder="Enter API Key..." class="w-full p-2.5 rounded-lg border border-slate-300 text-xs font-mono">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Topics / Specific Prompt Focus</label>
                                <input type="text" id="ai-prompt" placeholder="e.g. Passages, Lexis & Structure, Mechanics, Electricity, Algebra, Genetics" class="w-full p-3 rounded-lg border border-slate-300 text-xs" required>
                            </div>

                            <!-- Progress & Status Indicator -->
                            <div id="ai-progress-container" class="hidden space-y-2 p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl">
                                <div class="flex justify-between items-center text-xs font-bold text-jamb-green">
                                    <span id="ai-progress-status"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Generating 180 Batch...</span>
                                    <span id="ai-progress-text">0%</span>
                                </div>
                                <div class="w-full bg-emerald-200 h-2.5 rounded-full overflow-hidden">
                                    <div id="ai-progress-bar" class="bg-jamb-green h-full w-0 transition-all duration-300"></div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-2">
                                <p class="text-[11px] text-slate-500">Auto-chunks into 10-20 Qs API calls up to 180 questions maximum.</p>
                                <button type="submit" id="ai-submit-btn" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-2.5 px-6 rounded-xl transition text-xs flex items-center gap-2 shadow">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> Start AI Batch Generation
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- METHOD B: CSV / JSON BULK UPLOAD -->
                    <div id="admin-tab-upload" class="admin-tab-content space-y-4 hidden">
                        <div class="flex flex-col md:flex-row gap-6">
                            <div class="flex-grow">
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Upload CSV or JSON Batch (Up to 180 Questions)</label>
                                <div id="drop-zone" onclick="document.getElementById('file-input').click()" class="border-2 border-dashed border-slate-300 hover:border-jamb-green bg-slate-50 hover:bg-emerald-50/50 rounded-2xl p-8 text-center cursor-pointer transition">
                                    <i class="fa-solid fa-cloud-arrow-up text-4xl text-jamb-green mb-3"></i>
                                    <p class="text-xs font-bold text-slate-700">Click or drag CSV/JSON batch file here</p>
                                    <p class="text-[11px] text-slate-500 mt-1">Supports up to 180 questions in a single file upload</p>
                                    <input type="file" id="file-input" accept=".csv,.json" class="hidden" onchange="handleFileUpload(event)">
                                </div>
                            </div>

                            <div class="w-full md:w-80 bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col justify-between">
                                <div>
                                    <h4 class="font-bold text-xs uppercase text-slate-700 mb-2">Download Batch Templates</h4>
                                    <p class="text-[11px] text-slate-500 mb-3">Offline format templates supporting up to 180 items.</p>
                                    <div class="space-y-2">
                                        <button onclick="downloadSampleCSV()" class="w-full py-2 px-3 bg-white border border-slate-300 hover:bg-slate-100 rounded-lg text-xs font-semibold text-slate-700 flex items-center justify-between">
                                            <span><i class="fa-solid fa-file-csv text-green-600 mr-2"></i> CSV Template (180 Max)</span>
                                            <i class="fa-solid fa-download text-slate-400"></i>
                                        </button>
                                        <button onclick="downloadSampleJSON()" class="w-full py-2 px-3 bg-white border border-slate-300 hover:bg-slate-100 rounded-lg text-xs font-semibold text-slate-700 flex items-center justify-between">
                                            <span><i class="fa-solid fa-file-code text-blue-600 mr-2"></i> JSON Template</span>
                                            <i class="fa-solid fa-download text-slate-400"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Uploaded Preview Modal / Table -->
                        <div id="file-preview-container" class="hidden space-y-3 pt-4 border-t border-slate-200">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-xs text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-eye text-jamb-green"></i> File Batch Preview (<span id="parsed-count">0</span> Questions Loaded)
                                </h4>
                                <button onclick="importParsedQuestions()" class="bg-jamb-green hover:bg-jamb-darkgreen text-white font-bold py-1.5 px-4 rounded-lg text-xs transition flex items-center gap-1.5 shadow">
                                    <i class="fa-solid fa-file-circle-plus"></i> Append Batch to Question Bank
                                </button>
                            </div>
                            <div class="max-h-60 overflow-y-auto border border-slate-200 rounded-xl">
                                <table class="w-full text-left text-xs text-slate-600">
                                    <thead class="bg-slate-100 text-slate-700 uppercase font-bold sticky top-0">
                                        <tr>
                                            <th class="p-2 border-b">#</th>
                                            <th class="p-2 border-b">Subject</th>
                                            <th class="p-2 border-b">Question</th>
                                            <th class="p-2 border-b">Correct</th>
                                        </tr>
                                    </thead>
                                    <tbody id="parsed-table-body" class="divide-y divide-slate-200 bg-white"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- METHOD C: SINGLE MANUAL QUESTION CREATOR -->
                    <div id="admin-tab-manual" class="admin-tab-content space-y-4 hidden">
                        <form id="manual-question-form" onsubmit="handleManualSubmit(event)" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Subject</label>
                                    <select id="manual-subject" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs font-bold bg-white" required>
                                        <option value="Use of English">Use of English</option>
                                        <option value="Mathematics">Mathematics</option>
                                        <option value="Physics">Physics</option>
                                        <option value="Chemistry">Chemistry</option>
                                        <option value="Biology">Biology</option>
                                        <option value="Economics">Economics</option>
                                        <option value="Government">Government</option>
                                        <option value="Commerce">Commerce</option>
                                        <option value="Literature in English">Literature in English</option>
                                        <option value="CRS/IRS">CRK / IRK</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Topic / Module</label>
                                    <input type="text" id="manual-topic" placeholder="e.g. Comprehension / Mechanics" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Question Passage / Text</label>
                                <textarea id="manual-text" rows="3" placeholder="Enter standard UTME question prompt..." class="w-full p-3 rounded-lg border border-slate-300 text-xs" required></textarea>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 mb-1">Option A</label>
                                    <input type="text" id="manual-opt-a" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 mb-1">Option B</label>
                                    <input type="text" id="manual-opt-b" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 mb-1">Option C</label>
                                    <input type="text" id="manual-opt-c" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 mb-1">Option D</label>
                                    <input type="text" id="manual-opt-d" class="w-full p-2.5 rounded-lg border border-slate-300 text-xs" required>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Correct Answer</label>
                                    <select id="manual-correct" class="w-full p-2.5 rounded-lg border border-slate-300 font-bold text-jamb-green text-xs bg-white" required>
                                        <option value="A">Option A</option>
                                        <option value="B">Option B</option>
                                        <option value="C">Option C</option>
                                        <option value="D">Option D</option>
                                    </select>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Explanation / Solution</label>
                                    <input type="text" id="manual-explanation" placeholder="Provide step-by-step reasoning for candidates..." class="w-full p-2.5 rounded-lg border border-slate-300 text-xs" required>
                                </div>
                            </div>

                            <div class="flex justify-end pt-2">
                                <button type="submit" class="bg-jamb-green hover:bg-jamb-darkgreen text-white font-bold py-2.5 px-6 rounded-xl text-xs transition shadow flex items-center gap-2">
                                    <i class="fa-solid fa-plus"></i> Save to Master Question Bank
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

            <!-- QUESTION BANK MANAGER & MOCK EXAM CONFIGURATOR -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Draft Bank Pool (2 Cols) -->
                <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                            <div>
                                <h3 class="text-base font-extrabold text-slate-800">Master Question Bank Pool</h3>
                                <p class="text-xs text-slate-500">Filter, edit and manage questions in your master repository</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button onclick="loadDemo180Questions()" class="px-3 py-1.5 bg-emerald-100 text-jamb-green hover:bg-emerald-200 text-xs font-bold rounded-lg transition flex items-center gap-1">
                                    <i class="fa-solid fa-bolt"></i> Load 180-Q Full Combo Demo
                                </button>
                                <button onclick="clearDraftBank()" class="px-3 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 text-xs font-bold rounded-lg transition flex items-center gap-1">
                                    <i class="fa-solid fa-trash-can"></i> Clear Bank
                                </button>
                            </div>
                        </div>

                        <!-- Filters -->
                        <div class="flex flex-col sm:flex-row items-center gap-3 mb-4">
                            <div class="relative w-full sm:w-1/2">
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                                <input type="text" id="bank-search" oninput="renderQuestionBank()" placeholder="Search questions..." class="w-full pl-9 pr-3 py-2 text-xs border border-slate-300 rounded-lg">
                            </div>
                            <select id="bank-filter-subject" onchange="renderQuestionBank()" class="w-full sm:w-1/2 text-xs p-2 border border-slate-300 rounded-lg bg-white font-semibold">
                                <option value="ALL">All Subjects</option>
                                <option value="Use of English">Use of English</option>
                                <option value="Mathematics">Mathematics</option>
                                <option value="Physics">Physics</option>
                                <option value="Chemistry">Chemistry</option>
                                <option value="Biology">Biology</option>
                                <option value="Economics">Economics</option>
                                <option value="Government">Government</option>
                                <option value="Commerce">Commerce</option>
                            </select>
                        </div>

                        <!-- Bank List -->
                        <div id="draft-bank-list" class="space-y-3 max-h-[420px] overflow-y-auto pr-1"></div>
                    </div>
                </div>

                <!-- Mock Exam Configurator & Publisher (1 Col) -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between">
                    <div class="space-y-4">
